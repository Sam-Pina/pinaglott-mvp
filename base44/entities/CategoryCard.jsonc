{
  "name": "CategoryCard",
  "type": "object",
  "properties": {
    "word": {
      "type": "string",
      "description": "Palavra no idioma estudado"
    },
    "translation": {
      "type": "string",
      "description": "Tradu\u00e7\u00e3o no idioma nativo"
    },
    "example": {
      "type": "string",
      "description": "Frase de exemplo no idioma estudado"
    },
    "example_translation": {
      "type": "string",
      "description": "Tradu\u00e7\u00e3o da frase de exemplo"
    },
    "pronunciation": {
      "type": "string",
      "description": "Transcri\u00e7\u00e3o fon\u00e9tica/pron\u00fancia"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem"
    },
    "category_slug": {
      "type": "string",
      "description": "Slug da categoria"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Idioma da palavra"
    },
    "translation_language": {
      "type": "string",
      "default": "pt",
      "description": "Idioma da tradu\u00e7\u00e3o"
    }
  },
  "required": [
    "word",
    "translation",
    "category_slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}