{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da categoria"
    },
    "slug": {
      "type": "string",
      "description": "Identificador \u00fanico da categoria"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da categoria"
    },
    "icon": {
      "type": "string",
      "description": "Emoji/\u00edcone da categoria"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem de capa"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Idioma dos conte\u00fados"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Categoria ativa ou inativa"
    },
    "order": {
      "type": "integer",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}